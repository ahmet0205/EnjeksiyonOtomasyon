<Window x:Class="EnjeksiyonOtomasyon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enjeksiyon &amp; Klips Çakma SCADA / HMI Takip Sistemi" Height="650" Width="1000"
        Background="#2D3035" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst Panel: Sayaçlar, Reset ve Süreler -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- OK ve NOK Sayaçları -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Background="#27AE60" CornerRadius="8" Padding="15,8" Margin="0,0,10,0" Width="140">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="OK ÜRÜN" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtOkAdet" Text="0" Foreground="White" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#E74C3C" CornerRadius="8" Padding="15,8" Margin="0,0,10,0" Width="140">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="NOK ÜRÜN" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtNokAdet" Text="0" Foreground="White" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Kontrol Butonları -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnBaslat" Content="SİMÜLASYONU BAŞLAT" Background="#2980B9" Foreground="White" FontWeight="Bold" Padding="15,10" Margin="5" Click="BtnBaslat_Click"/>
                <Button x:Name="BtnReset" Content="SAYAÇ SIFIRLA" Background="#7F8C8D" Foreground="White" FontWeight="Bold" Padding="15,10" Margin="5" Click="BtnReset_Click"/>
            </StackPanel>

            <!-- Süre Göstergeleri -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Border Background="#34495E" CornerRadius="6" Padding="10,5" Margin="5" Width="110">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ENJ. 1 (sn)" Foreground="#BDC3C7" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtEnj1" Text="15" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#34495E" CornerRadius="6" Padding="10,5" Margin="5" Width="110">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ENJ. 2 (sn)" Foreground="#BDC3C7" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtEnj2" Text="15" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#34495E" CornerRadius="6" Padding="10,5" Margin="5" Width="110">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SOĞUTMA (sn)" Foreground="#BDC3C7" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtSogutma" Text="60" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Orta Panel: Makine Görseli ve Canlı Sensör Noktaları -->
        <Border Grid.Row="1" Background="#1E2024" CornerRadius="10" BorderBrush="#3F424A" BorderThickness="1">
            <Grid>
                <!-- Makine Durum Görselleştirmesi -->
                <TextBlock Text="[ ENDÜSTRİYEL İSTASYON CANLI İZLEME ]" Foreground="#5D6D7E" FontSize="18" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>

                <!-- 3 Sensör / Varlık Göstergesi (Kırmızı/Yeşil Noktalar) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Margin="25" HorizontalAlignment="Center">
                        <Ellipse x:Name="LedSensor1" Width="40" Height="40" Fill="#E74C3C" Stroke="White" StrokeThickness="2"/>
                        <TextBlock Text="Boru 1 Sensörü" Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="25" HorizontalAlignment="Center">
                        <Ellipse x:Name="LedSensor2" Width="40" Height="40" Fill="#E74C3C" Stroke="White" StrokeThickness="2"/>
                        <TextBlock Text="Boru 2 Sensörü" Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="25" HorizontalAlignment="Center">
                        <Ellipse x:Name="LedPim" Width="40" Height="40" Fill="#E74C3C" Stroke="White" StrokeThickness="2"/>
                        <TextBlock Text="Pim Kilidi" Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Alt Durum Paneli -->
        <Border Grid.Row="2" Background="#17202A" CornerRadius="8" Padding="15" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="DURUM: " Foreground="#F39C12" FontWeight="Bold" FontSize="16"/>
                <TextBlock x:Name="TxtDurum" Text="BEKLENİYOR..." Foreground="White" FontWeight="Bold" FontSize="16"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>